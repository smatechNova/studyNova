{
  "name": "studynova",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "api": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "api:clear-dev-accounts": "node scripts/clear-dev-accounts.mjs",
    "api:prod": "python -m uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8000",
    "api:smoke": "node scripts/api-smoke-test.mjs",
    "api:test": "python -m pytest apps/api/tests",
    "closed-test:api-env": "node scripts/api-smoke-test.mjs --write-mobile-env",
    "closed-test:preflight": "node scripts/closed-test-preflight.mjs",
    "mobile": "node scripts/start-mobile.mjs",
    "mobile:codespace": "npm --workspace @studynova/mobile run start:codespace",
    "mobile:codespace:tunnel": "npm --workspace @studynova/mobile run start:codespace -- --tunnel",
    "mobile:codespace:clear": "npm --workspace @studynova/mobile run start:codespace -- --tunnel --clear",
    "mobile:android": "npm --workspace @studynova/mobile run android",
    "mobile:export:web": "node scripts/export-mobile-web.mjs",
    "mobile:assets": "node scripts/generate-mobile-assets.mjs",
    "mobile:release-check": "node scripts/mobile-release-check.mjs",
    "security:release": "npm audit --omit=dev --audit-level=high",
    "mobile:build:closed-test": "npm --workspace @studynova/mobile run build:closed-test",
    "mobile:submit:closed-test": "npm --workspace @studynova/mobile run submit:closed-test",
    "mobile:typecheck": "npm --workspace @studynova/mobile run typecheck"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "shell-quote": "^1.10.0",
    "ws": "^7.5.13"
  }
}
