APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
ALLOWED_ORIGIN_REGEX=https://.*\.app\.github\.dev
LOCAL_DATA_PATH=apps/api/.data/studynova.sqlite3
BACKUP_DATA_PATH=apps/api/.data/backups
STUDY_PROOF_STORAGE_BACKEND=local
STUDY_PROOF_LOCAL_PATH=apps/api/.data/study-proofs
STUDY_PROOF_MAX_UPLOAD_MB=6
FIREBASE_STORAGE_BUCKET=
SESSION_SECRET=change-this-before-production
SESSION_TTL_HOURS=168
ADMIN_ACCESS_CODE=studynova-admin-dev

# Required for production readiness checks and mobile closed-test builds.
PUBLIC_API_BASE_URL=https://your-api-host.example.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
