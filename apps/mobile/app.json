{
  "expo": {
    "name": "StudyNova",
    "slug": "studynova",
    "scheme": "studynova",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.smatech.studynova",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be3e9e19-91e1-47a3-8a87-d709df81cd59"
      }
    }
  }
}
