{
  "expo": {
    "name": "StudyNova",
    "slug": "studynova",
    "description": "Smart study planner and parent progress monitor for students.",
    "scheme": "studynova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#102A43"
      }
    },
    "android": {
      "package": "com.studynova.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A43"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB",
          "defaultChannel": "study-reminders"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "StudyNova uses the camera only when a student chooses to attach a study proof photo for parent review.",
          "photosPermission": "StudyNova uses photo access only when a student chooses an image or screenshot as study proof.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be3e9e19-91e1-47a3-8a87-d709df81cd59"
      }
    }
  }
}
