{
  "name": "@studynova/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:codespace": "EXPO_UNSTABLE_HEADLESS=1 REACT_DEBUGGER=echo expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "node ../../scripts/export-mobile-web.mjs",
    "release:check": "node ../../scripts/mobile-release-check.mjs",
    "build:preview": "npm run release:check && npx eas-cli@latest build --platform android --profile preview",
    "build:closed-test": "npm run release:check && npx eas-cli@latest build --platform android --profile closed-test",
    "submit:closed-test": "npx eas-cli@latest submit --platform android --profile closed-test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "expo": "~55.0.28",
    "expo-auth-session": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.22",
    "expo-linking": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "~55.0.18",
    "firebase": "^12.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~55.0.24",
    "typescript": "~5.9.2"
  }
}
