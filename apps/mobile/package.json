{
  "name": "@studynova/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:codespace": "EXPO_UNSTABLE_HEADLESS=1 REACT_DEBUGGER=echo expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "release:check": "node ../../scripts/mobile-release-check.mjs",
    "build:preview": "npm run release:check && npx eas-cli@latest build --platform android --profile preview",
    "build:closed-test": "npm run release:check && npx eas-cli@latest build --platform android --profile closed-test",
    "submit:closed-test": "npx eas-cli@latest submit --platform android --profile closed-test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~55.0.0",
    "expo-auth-session": "^55.0.16",
    "expo-image-picker": "~55.0.20",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "^55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
