# StudyNova Render closed-test backend environment
#
# Copy these keys into the Render service environment tab.
# Keep private values out of Git and rotate them if they are shared accidentally.

APP_ENV=production
LOCAL_DATA_PATH=/var/data/studynova/studynova.sqlite3
BACKUP_DATA_PATH=/var/data/studynova/backups
STUDY_PROOF_STORAGE_BACKEND=firebase
STUDY_PROOF_LOCAL_PATH=/var/data/studynova/study-proofs
STUDY_PROOF_MAX_UPLOAD_MB=6
SESSION_TTL_HOURS=168
PUBLIC_API_BASE_URL=https://your-render-service.onrender.com
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=
SESSION_SECRET=replace-with-32-plus-private-random-characters
ADMIN_ACCESS_CODE=replace-with-private-admin-code
FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-firebase-admin-json-when-google-sign-in-is-enabled
FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-private-resend-api-key
EMAIL_FROM=StudyNova <accounts@studynova.app>
SUPPORT_EMAIL=support@studynova.app
EMAIL_VERIFICATION_TTL_MINUTES=20
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_REQUESTS_PER_HOUR=5
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
